{
  "name": "@peter.naydenov/deep-copy",
  "version": "3.0.0",
  "description": "Immutable copies of javascript objects and arrays",
  "main": "src/main.js",
  "type": "module",
  "scripts": {
    "test": "mocha test",
    "cover": "c8 mocha test",
    "build": "vite build",
    "benchmark:speed": "node benchmarks/speed.mjs",
    "benchmark:memory": "node benchmarks/memory.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PeterNaydenov/deep-copy.git"
  },
  "author": "Peter Naydenov",
  "license": "MIT",
  "devDependencies": {
    "c8": "12.0.0",
    "chai": "6.3.0",
    "mocha": "12.0.3",
    "vite": "^8.3.5"
  },
  "overrides": {
    "diff": ">=8.0.3",
    "serialize-javascript": ">=7.0.5"
  },
  "c8": {
    "include": [
      "src/**/*.js"
    ],
    "exclude": [
      "node_modules",
      "test",
      "test-data"
    ],
    "reporter": [
      "lcov",
      "text-summary"
    ]
  },
  "browserslist": "> 2%, not dead",
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
