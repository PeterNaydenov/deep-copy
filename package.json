{
  "name": "@peter.naydenov/deep-copy",
  "version": "3.0.2",
  "description": "Immutable copies of javascript objects and arrays",
  "main": "./dist/deep-copy.cjs",
  "type": "module",
  "scripts": {
    "test": "mocha test && npm run test:types",
    "cover": "c8 mocha test",
    "build": "vite build && npm run build:types",
    "benchmark:speed": "node benchmarks/speed.mjs",
    "benchmark:memory": "node benchmarks/memory.mjs",
    "prepack": "npm run build",
    "build:types": "tsc --project tsconfig.json",
    "test:types": "tsc --ignoreConfig --noEmit --strict --skipLibCheck --module nodenext --target es2022 test/types/esm.mts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PeterNaydenov/deep-copy.git"
  },
  "author": "Peter Naydenov",
  "license": "MIT",
  "devDependencies": {
    "c8": "12.0.0",
    "chai": "6.3.0",
    "mocha": "12.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "overrides": {
    "diff": ">=8.0.3",
    "serialize-javascript": ">=7.0.5"
  },
  "c8": {
    "include": [
      "src/**/*.js"
    ],
    "exclude": [
      "node_modules",
      "test",
      "test-data"
    ],
    "reporter": [
      "lcov",
      "text-summary"
    ]
  },
  "browserslist": "> 2%, not dead",
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "exports": {
    ".": {
      "import": {
        "types": "./include/main.d.ts",
        "default": "./dist/deep-copy.esm.mjs"
      },
      "require": "./dist/deep-copy.cjs"
    },
    "./*": "./*"
  },
  "files": [
    "src",
    "dist",
    "include",
    "Changelog.md"
  ],
  "types": "./include/main.d.ts"
}
